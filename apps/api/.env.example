# ==============================================================================
# Serene Health — Backend API Environment Variables (.env)
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://serene:serene_password_2026@localhost:5432/serene_health?schema=public"

# Authentication (minimum 32 characters)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key-serene-health"

# Server Port
PORT=3000

# Frontend URL (automatically granted CORS access)
# Local: "http://localhost:5173"
# Production: "https://yourdomain.com"
FRONTEND_URL="http://localhost:5173"

# Google Gemini AI Integration (Server-side only — NEVER expose to frontend)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
